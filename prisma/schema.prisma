/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model profiles {
  id                String             @id(map: "pk_profiles") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auth_user_id      String             @unique(map: "uq_profiles_auth_user_id") @db.Uuid
  display_name      String?            @db.VarChar(150)
  email             String?            @db.VarChar(255)
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime           @default(now()) @db.Timestamptz(6)
  admin_access      admin_access?
  admin_audit_logs  admin_audit_logs[]
  verified_payments payments[]         @relation("payments_verified_by")

  @@index([email], map: "idx_profiles_email")
}

enum league_status {
  DRAFT
  OPEN_FOR_REGISTRATION
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  ARCHIVED
}

enum payment_method {
  CASH
  GCASH
  BANK_TRANSFER
  OTHER
}

enum payment_status {
  PENDING
  VERIFIED
  REJECTED
  REFUNDED
}

enum registration_status {
  PENDING_PAYMENT
  VERIFIED
  REJECTED
  CANCELLED
}
